<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=yes">
<title>Generando...</title>
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#0A0E17">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<style>
:root{
  --brand:#7B2FF7;
  --brand-2:#FF00E5;
  --accent:#00D4FF;
  --ok:#25D366;
  --ok-2:#00B84A;
  --bg:#0A0E17;
  --bg-2:#141A2A;
  --surface:rgba(255,255,255,.04);
  --surface-2:rgba(255,255,255,.07);
  --border:rgba(255,255,255,.09);
  --border-strong:rgba(255,255,255,.16);
  --text:#F5F5F7;
  --text-dim:#9AA4B2;
  --text-mute:#6E7684;
  --radius-lg:26px;
  --radius-md:18px;
  --radius-sm:12px;
  --shadow-1:0 1px 2px rgba(0,0,0,.4), 0 8px 24px rgba(0,0,0,.28);
  --shadow-2:0 12px 40px rgba(0,0,0,.55);
  --ease:cubic-bezier(.2,.8,.2,1);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{width:100%;overflow-x:hidden;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
body{
  font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;
  font-feature-settings:'cv02','cv03','cv04','cv11','ss01';
  color:var(--text);
  background:var(--bg);
  line-height:1.5;
  letter-spacing:-0.01em;
}

/* ============ PANTALLA DE CARGA (mientras lee datos) ============ */
#loading{
  position:fixed;inset:0;z-index:9999;
  background:linear-gradient(135deg,var(--brand) 0%,var(--brand-2) 100%);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:30px;
  transition:opacity .75s var(--ease), transform .75s var(--ease);
  overflow:hidden;
}
#loading::before{
  content:'';position:absolute;inset:0;
  background:
    radial-gradient(600px 300px at 20% 100%, rgba(255,255,255,.18), transparent 70%),
    radial-gradient(600px 300px at 90% 10%, rgba(0,212,255,.25), transparent 70%);
  pointer-events:none;
}
#loading.saliendo{opacity:0;transform:scale(1.08);pointer-events:none}
.loading-logo{
  width:120px;height:120px;border-radius:50%;object-fit:cover;
  border:4px solid rgba(255,255,255,.95);background:#fff;
  box-shadow:0 20px 60px rgba(0,0,0,.4);
  position:relative;
}
.loading-nombre{margin-top:26px;color:#fff;font-size:26px;font-weight:800;text-align:center;letter-spacing:-0.03em}
.loading-slogan{margin-top:10px;color:rgba(255,255,255,.9);font-size:14.5px;font-weight:500;font-style:italic;text-align:center}
.loading-loader{
  margin-top:36px;width:44px;height:44px;
  border:3px solid rgba(255,255,255,.25);
  border-top-color:#fff;border-radius:50%;
  animation:loaderSpin .9s linear infinite;
}
@keyframes loaderSpin{to{transform:rotate(360deg)}}

#errorBox{
  position:fixed;inset:0;z-index:10000;
  background:#0A0E17;color:#F5F5F7;
  display:none;flex-direction:column;align-items:center;justify-content:center;
  padding:30px;text-align:center;
}
#errorBox.show{display:flex}
#errorBox h2{color:#FF4D6D;font-size:20px;margin-bottom:10px}
#errorBox p{color:#9AA4B2;font-size:14px;max-width:340px;line-height:1.6}

/* ============ PANTALLA PRINCIPAL ============ */
.pantalla{
  height:100vh;height:100dvh;
  display:flex;flex-direction:column;
  overflow:hidden;
  background:
    radial-gradient(900px 500px at 100% -10%, rgba(123,47,247,.14), transparent 60%),
    radial-gradient(700px 400px at -10% 110%, rgba(255,0,229,.10), transparent 60%),
    var(--bg);
  display:none;
}
.pantalla.activa{display:flex}

/* 🖼️ BANNER — fix aplicado: grande hasta las fotos, tope 38dvh */
.pantalla .banner{
  flex:1 1 auto;
  min-height:140px;
  max-height:38dvh;
  height:auto;
  transition:flex-grow .6s var(--ease), max-height .6s var(--ease);
  border-radius:0 0 26px 26px;
  position:relative;
  z-index:5;
  background-color:var(--brand);
  background-size:cover;
  background-position:center;
  background-repeat:no-repeat;
  overflow:hidden;
  box-shadow:0 8px 24px rgba(0,0,0,.35);
}
.pantalla .banner::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(180deg, rgba(10,14,23,0) 40%, rgba(10,14,23,.85) 100%);
  pointer-events:none;
}
.pantalla .desc{
  flex:0 0 auto;
  padding:12px 20px 0;
  font-size:12.5px;line-height:1.45;
  color:var(--text-dim);text-align:center;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
.pantalla .sec-titulo{
  flex:0 0 auto;
  padding:14px 16px 8px;
  font-size:14px;font-weight:800;
  letter-spacing:-0.02em;
  display:flex;align-items:center;gap:8px;
}
.pantalla .sec-titulo::before{
  content:'';width:4px;height:16px;border-radius:2px;
  background:linear-gradient(var(--brand),var(--accent));
  box-shadow:0 0 12px rgba(123,47,247,.6);
}

.pantalla .catalogo{
  flex:1 1 0;
  min-height:0;
  overflow-y:auto;
  display:grid;
  grid-template-columns:repeat(2,1fr);
  grid-template-rows:repeat(var(--filas,2),minmax(84px,1fr));
  gap:8px;
  padding:0 12px 4px;
  scrollbar-width:thin;
  scrollbar-color:rgba(255,255,255,.15) transparent;
}
.pantalla .catalogo::-webkit-scrollbar{width:4px}
.pantalla .catalogo::-webkit-scrollbar-thumb{background:rgba(255,255,255,.15);border-radius:2px}

.prod{
  position:relative;min-height:0;
  border-radius:var(--radius-md);
  overflow:hidden;background:var(--bg-2);
  cursor:pointer;border:1px solid var(--border);
  box-shadow:var(--shadow-1);
  transition:transform .25s var(--ease), border-color .25s var(--ease), box-shadow .25s var(--ease);
}
.prod:active{transform:scale(.96)}
@media (hover:hover){
  .prod:hover{transform:translateY(-3px);border-color:var(--border-strong);box-shadow:0 12px 32px rgba(0,0,0,.5), 0 0 0 1px rgba(123,47,247,.25)}
}
.prod img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s var(--ease)}
@media (hover:hover){ .prod:hover img{transform:scale(1.06)} }
.prod-info{
  position:absolute;left:0;right:0;bottom:0;
  padding:26px 10px 9px;
  background:linear-gradient(to top,rgba(0,0,0,.88),rgba(0,0,0,.45) 55%,rgba(0,0,0,0));
  display:flex;align-items:flex-end;justify-content:space-between;gap:6px;z-index:1;
}
.prod-nombre{
  font-size:12.5px;font-weight:700;color:#fff;line-height:1.2;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
  text-shadow:0 1px 3px rgba(0,0,0,.6);
}
.prod-precio{
  flex:0 0 auto;font-size:12px;font-weight:800;color:#fff;
  padding:3px 9px;border-radius:999px;
  background:linear-gradient(135deg,var(--brand),var(--brand-2));
  box-shadow:0 2px 8px rgba(0,0,0,.4), inset 0 1px 0 rgba(255,255,255,.22);
  white-space:nowrap;
}
.prod-badge{
  display:none;position:absolute;top:8px;right:8px;z-index:2;
  min-width:24px;height:24px;padding:0 7px;border-radius:12px;
  background:var(--accent);color:#000;font-size:12px;font-weight:900;
  align-items:center;justify-content:center;
  box-shadow:0 2px 8px rgba(0,0,0,.5), inset 0 1px 0 rgba(255,255,255,.35);
  animation:badgePop .3s var(--ease);
}
.prod-badge.on{display:flex}
@keyframes badgePop{0%{transform:scale(0)}60%{transform:scale(1.15)}100%{transform:scale(1)}}
.prod-ph{cursor:default;box-shadow:none;border:1px dashed rgba(255,255,255,.15);background:#141A2A}
.prod-ph:active{transform:none}
.prod-ph img{object-fit:contain;background:#141A2A}

.pantalla .total-card{
  flex:0 0 auto;margin:10px 12px 0;padding:10px 16px;
  border-radius:var(--radius-md);
  display:flex;align-items:center;justify-content:space-between;gap:10px;
  background:linear-gradient(135deg, rgba(255,255,255,.06), rgba(255,255,255,.02));
  border:1px solid var(--border);
  backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
  box-shadow:var(--shadow-1);
}
.tc-label{font-size:13px;font-weight:700;color:#C9D1DC}
.tc-items{font-size:11.5px;color:#8A94A3;margin-top:2px}
.tc-monto{
  font-size:24px;font-weight:800;line-height:1;letter-spacing:-0.04em;
  background:linear-gradient(135deg,var(--accent),var(--brand));
  -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
  font-variant-numeric:tabular-nums;
}
.pantalla .barra-pedido{
  flex:0 0 auto;padding:10px 12px;
  padding-bottom:calc(10px + env(safe-area-inset-bottom));
}
.btn-unico{
  display:flex;align-items:center;justify-content:center;
  width:100%;min-height:52px;border:none;border-radius:16px;
  background:linear-gradient(135deg,var(--brand) 0%,var(--brand-2) 100%);
  color:#fff;font-family:inherit;font-size:15.5px;font-weight:800;
  letter-spacing:-0.015em;cursor:pointer;padding:14px 20px;
  box-shadow:0 8px 24px rgba(123,47,247,.45), 0 2px 6px rgba(0,0,0,.3), inset 0 1px 0 rgba(255,255,255,.28);
  transition:transform .15s var(--ease), box-shadow .3s var(--ease), background .4s var(--ease);
}
.btn-unico:active{transform:scale(.98)}
.btn-unico.estado-enviar{
  background:linear-gradient(135deg,var(--ok),var(--ok-2));
  box-shadow:0 8px 24px rgba(37,211,102,.45), 0 2px 6px rgba(0,0,0,.3), inset 0 1px 0 rgba(255,255,255,.28);
}

/* ============ MODALES ============ */
.modal-overlay{
  display:none;position:fixed;inset:0;
  background:rgba(6,6,10,.78);
  backdrop-filter:blur(16px) saturate(140%);
  -webkit-backdrop-filter:blur(16px) saturate(140%);
  z-index:6000;align-items:center;justify-content:center;
  padding:12px;overflow:hidden;animation:fadeIn .25s var(--ease);
}
.modal-overlay.activo{display:flex}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes modalIn{from{opacity:0;transform:translateY(20px) scale(.96)}to{opacity:1;transform:translateY(0) scale(1)}}

.mp-inner{
  background:linear-gradient(180deg,#16181f 0%,#0f1117 100%);
  border:1px solid var(--border-strong);border-radius:28px;padding:0;
  max-width:420px;width:100%;max-height:calc(100dvh - 24px);
  display:flex;flex-direction:column;margin:auto;position:relative;overflow:hidden;
  box-shadow:var(--shadow-2), 0 0 0 1px rgba(255,255,255,.04);
  animation:modalIn .35s var(--ease);
}
.mp-foto{position:relative;flex:0 1 auto;min-height:0;background:#0a0e17}
.mp-foto img{display:block;width:100%;aspect-ratio:4/3;max-height:46dvh;object-fit:cover}
.mp-foto::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 60%,rgba(15,17,23,.9) 100%);pointer-events:none}
.mp-x{
  position:absolute;top:12px;right:12px;width:38px;height:38px;border-radius:50%;
  border:1px solid rgba(255,255,255,.15);background:rgba(15,17,23,.7);
  backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
  color:#fff;font-size:20px;line-height:1;font-weight:400;cursor:pointer;
  display:flex;align-items:center;justify-content:center;z-index:2;
  transition:transform .2s var(--ease), background .2s var(--ease);
}
.mp-x:active{transform:scale(.9);background:rgba(255,255,255,.15)}
.mp-body{padding:16px 18px 18px;flex:0 0 auto}
.mp-head{display:flex;align-items:center;justify-content:space-between;gap:10px;text-align:left}
.mp-nombre{font-size:18px;font-weight:800;color:var(--text);line-height:1.2;letter-spacing:-0.025em}
.mp-precio{
  flex:0 0 auto;font-size:14px;font-weight:800;color:#fff;padding:5px 12px;border-radius:999px;
  background:linear-gradient(135deg,var(--brand),var(--brand-2));
  box-shadow:0 4px 14px rgba(123,47,247,.4), inset 0 1px 0 rgba(255,255,255,.25);
}
.mp-cant{display:flex;align-items:center;justify-content:center;gap:18px;margin:16px 0 6px}
.btn-cant{
  width:48px;height:48px;border-radius:16px;border:1px solid var(--border-strong);
  background:var(--surface);color:var(--text);font-size:22px;font-weight:600;
  cursor:pointer;display:flex;align-items:center;justify-content:center;
  transition:all .2s var(--ease);font-family:inherit;
}
.btn-cant:active{transform:scale(.94);background:linear-gradient(135deg,var(--brand),var(--brand-2));border-color:transparent;color:#fff;box-shadow:0 6px 18px rgba(123,47,247,.4)}
.cant-num{font-size:24px;min-width:34px;text-align:center;font-weight:800;color:var(--text);font-variant-numeric:tabular-nums}
.mp-sub{font-size:13px;color:var(--text-dim);margin-bottom:12px;text-align:center;font-weight:500}
.btn-confirmar{
  width:100%;padding:14px;border-radius:14px;border:none;
  background:linear-gradient(135deg,var(--ok),var(--ok-2));
  color:#fff;font-weight:800;font-size:15px;
  font-family:inherit;letter-spacing:-0.015em;cursor:pointer;
  box-shadow:0 6px 20px rgba(37,211,102,.4), inset 0 1px 0 rgba(255,255,255,.25);
  transition:transform .15s var(--ease);
}
.btn-confirmar:active{transform:scale(.98)}

.ubi-inner{
  background:linear-gradient(180deg,#16181f 0%,#0f1117 100%);
  border:1px solid var(--border-strong);border-radius:28px;padding:20px;
  max-width:520px;width:100%;max-height:calc(100dvh - 24px);
  overflow-y:auto;margin:auto;position:relative;
  box-shadow:var(--shadow-2), 0 0 0 1px rgba(255,255,255,.04);
  animation:modalIn .35s var(--ease);
}
.ubi-inner h2{font-size:19px;color:#fff;margin-bottom:6px;text-align:center;letter-spacing:-0.025em;font-weight:800}
.ubi-inner .sub{font-size:13px;color:var(--text-dim);text-align:center;margin-bottom:14px;line-height:1.5}
.btn-gps{
  width:100%;padding:13px;border-radius:14px;border:none;
  background:linear-gradient(135deg,var(--accent),var(--brand));
  color:#fff;font-weight:800;font-size:14px;font-family:inherit;
  letter-spacing:-0.01em;cursor:pointer;margin-bottom:10px;
  box-shadow:0 6px 20px rgba(0,212,255,.35), inset 0 1px 0 rgba(255,255,255,.25);
  transition:transform .15s var(--ease);
}
.btn-gps:active{transform:scale(.98)}
.ubi-mapa{
  width:100%;height:clamp(140px,30vh,260px);
  border-radius:12px;border:2px solid var(--brand);margin-bottom:8px;
  overflow:hidden;background:#0a0e17;
}
.ubi-estado{
  font-size:12px;color:#FFB300;text-align:center;margin-bottom:12px;
  min-height:16px;padding:8px 10px;border-radius:8px;
  background:rgba(255,179,0,.08);border:1px solid rgba(255,179,0,.18);
  transition:all .3s var(--ease);
}
.ubi-estado.ok{color:#4ADE80;font-weight:700;background:rgba(37,211,102,.1);border-color:rgba(37,211,102,.25)}
.ubi-confirmar{
  width:100%;padding:15px;border-radius:14px;border:none;
  background:linear-gradient(135deg,var(--ok),var(--ok-2));
  color:#fff;font-weight:800;font-size:15px;font-family:inherit;
  letter-spacing:-0.015em;cursor:pointer;
  box-shadow:0 6px 20px rgba(37,211,102,.4), inset 0 1px 0 rgba(255,255,255,.25);
  transition:transform .15s var(--ease), opacity .2s;
}
.ubi-confirmar:active{transform:scale(.98)}
.ubi-confirmar:disabled{opacity:.4;cursor:not-allowed;box-shadow:none}
.ubi-cerrar{
  position:absolute;top:12px;right:14px;background:var(--surface);border:1px solid var(--border);
  border-radius:50%;width:34px;height:34px;color:var(--text-dim);font-size:18px;
  cursor:pointer;font-weight:400;display:flex;align-items:center;justify-content:center;
  transition:all .2s var(--ease);
}
.ubi-cerrar:active{transform:scale(.9);background:var(--surface-2)}

.modal-pedido{
  background:linear-gradient(180deg,#16181f 0%,#0f1117 100%);
  border:1px solid var(--border-strong);border-radius:28px;padding:20px;
  max-width:480px;width:100%;max-height:calc(100dvh - 24px);
  display:flex;flex-direction:column;margin:auto;position:relative;
  box-shadow:var(--shadow-2), 0 0 0 1px rgba(255,255,255,.04);
  animation:modalIn .35s var(--ease);
}
.modal-pedido h2{font-size:19px;color:#fff;margin-bottom:2px;padding-right:36px;letter-spacing:-0.025em;font-weight:800}
.modal-pedido .sub{font-size:12.5px;color:var(--text-dim);margin-bottom:10px}
.modal-pedido label{display:block;font-size:13px;font-weight:700;color:var(--text);margin-bottom:4px;margin-top:8px}
.modal-pedido input{
  width:100%;padding:12px 14px;border-radius:12px;
  border:1px solid var(--border-strong);background:var(--surface);
  color:var(--text);font-size:15px;font-family:inherit;
  transition:border-color .2s, background .2s, box-shadow .2s;
}
.modal-pedido input::placeholder{color:var(--text-mute)}
.modal-pedido input:focus{
  outline:none;border-color:var(--brand);background:var(--surface-2);
  box-shadow:0 0 0 3px rgba(123,47,247,.15);
}
.privacidad{
  font-size:10.5px;color:var(--text-mute);line-height:1.5;padding:9px 12px;
  background:var(--surface);border-radius:10px;margin:10px 0;
  border-left:3px solid var(--accent);
}
.resumen{
  background:rgba(37,211,102,.06);border:1px solid rgba(37,211,102,.2);
  border-radius:12px;padding:10px 12px;margin:8px 0;
  font-size:13px;line-height:1.55;color:var(--text);
  flex:1 1 auto;min-height:60px;overflow-y:auto;
}
.resumen strong{color:#4ADE80;font-weight:800}
.resumen-total{
  flex:0 0 auto;text-align:center;font-weight:800;font-size:17px;color:var(--accent);
  letter-spacing:-0.02em;padding:8px 0;margin-bottom:8px;
  border-top:1px solid var(--border);border-bottom:1px solid var(--border);
  font-variant-numeric:tabular-nums;
}

.leaflet-container{background:#0a0e17;font-family:'Inter',sans-serif}
.leaflet-tile{filter:invert(1) hue-rotate(180deg) brightness(.85) contrast(.9)}
.leaflet-control-attribution{background:rgba(15,17,23,.85)!important;color:var(--text-mute)!important;font-size:9px!important;border-radius:6px}
.leaflet-control-attribution a{color:var(--text-dim)!important}
.leaflet-bar{border:1px solid var(--border-strong)!important;box-shadow:var(--shadow-1)!important;border-radius:10px!important;overflow:hidden}
.leaflet-bar a{background:rgba(15,17,23,.9)!important;color:var(--text)!important;border-bottom-color:var(--border)!important}
</style>
</head>
<body>

<!-- PANTALLA DE CARGA -->
<div id="loading">
  <img class="loading-logo" id="loadLogo" alt="Logo">
  <h1 class="loading-nombre" id="loadNombre"></h1>
  <p class="loading-slogan" id="loadSlogan"></p>
  <div class="loading-loader"></div>
</div>

<!-- PANTALLA DE ERROR -->
<div id="errorBox">
  <h2>⚠️ No se recibieron datos</h2>
  <p id="errorMsg">Abre esta página desde el generador o asegúrate de que <code>localStorage.landingData</code> exista.</p>
</div>

<!-- PANTALLA PRINCIPAL -->
<main class="pantalla" id="pantalla">
  <div class="banner" id="banner"></div>
  <p class="desc" id="descripcion"></p>
  <h2 class="sec-titulo">Toca un producto para pedir</h2>

  <section class="catalogo" id="catalogo"></section>

  <section class="total-card">
    <div>
      <div class="tc-label">🧾 Total de tu pedido</div>
      <div class="tc-items" id="totalItems">Aún no agregas productos</div>
    </div>
    <div class="tc-monto" id="totalMonto">$0</div>
  </section>

  <div class="barra-pedido">
    <button type="button" class="btn-unico" id="btnUnico" onclick="accionBotonUnico()">
      <span id="buLinea2">📍 Activar mi ubicación</span>
    </button>
  </div>
</main>

<!-- MODAL PRODUCTO -->
<div class="modal-overlay" id="modalProducto" onclick="if(event.target===this)cerrarProducto()">
  <div class="mp-inner">
    <div class="mp-foto">
      <img id="mpImg" alt="">
      <button type="button" class="mp-x" onclick="cerrarProducto()">×</button>
    </div>
    <div class="mp-body">
      <div class="mp-head">
        <div class="mp-nombre" id="mpNombre"></div>
        <div class="mp-precio" id="mpPrecio"></div>
      </div>
      <div class="mp-cant">
        <button type="button" class="btn-cant" onclick="pedidoRestar(prodActual)">−</button>
        <span class="cant-num" id="mpCant">0</span>
        <button type="button" class="btn-cant" onclick="pedidoSumar(prodActual)">+</button>
      </div>
      <div class="mp-sub" id="mpSub"></div>
      <button type="button" class="btn-confirmar" onclick="cerrarProducto()">✅ Listo</button>
    </div>
  </div>
</div>

<!-- MODAL UBICACIÓN -->
<div class="modal-overlay" id="ubiModal" onclick="if(event.target===this)cerrarUbiModal()">
  <div class="ubi-inner">
    <button type="button" class="ubi-cerrar" onclick="cerrarUbiModal()">×</button>
    <h2>📍 Confirma tu ubicación</h2>
    <p class="sub">Necesitamos saber dónde entregar tu pedido.</p>
    <button type="button" class="btn-gps" onclick="ubiUsarGPS()">📡 Usar mi ubicación en tiempo real</button>
    <div class="ubi-mapa" id="ubiMapa"></div>
    <div class="ubi-estado" id="ubiEstado">Toca el mapa para marcar tu ubicación exacta</div>
    <button type="button" class="ubi-confirmar" id="ubiConfirmar" onclick="ubiConfirmarUbicacion()" disabled>✅ Confirmar esta ubicación</button>
  </div>
</div>

<!-- MODAL PEDIDO -->
<div class="modal-overlay" id="modalPedido" onclick="if(event.target===this)cerrarModalPedido()">
  <div class="modal-pedido">
    <button type="button" class="ubi-cerrar" onclick="cerrarModalPedido()">×</button>
    <h2>🛒 Confirmar pedido</h2>
    <p class="sub">Solo falta tu nombre para enviar el pedido</p>
    <label>👤 Tu nombre</label>
    <input type="text" id="clienteNombre" placeholder="Ej. Juan Pérez" maxlength="60">
    <div id="resumenPedido" class="resumen"></div>
    <div id="resumenTotal" class="resumen-total"></div>
    <p class="privacidad">🔒 Tus datos (nombre, ubicación y pedido) se usan solo para este pedido y no se comparten con terceros.</p>
    <button type="button" class="btn-confirmar" onclick="confirmarPedido()">✅ Revisar y enviar por WhatsApp</button>
  </div>
</div>

<script>
/* ==========================================================
   HELPERS ORIGINALES (idénticos al generador)
   ========================================================== */
function nombreVisible(nombre){ return String(nombre || 'Negocio').split('&')[0].trim() || 'Negocio'; }
function esUrlImagen(v){ return /^https?:\/\//.test(v) || /^data:image\//.test(v); }
function escHTML(s){ return String(s==null?'':s).replace(/[&<>"']/g, function(c){return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]);}); }

/* ==========================================================
   LECTURA DE DATOS (misma que el generador original)
   ========================================================== */
var negocioActual = null;

document.addEventListener('DOMContentLoaded', function(){
  var datos = null;
  try {
    var raw = localStorage.getItem('landingData');
    if(raw) datos = JSON.parse(raw);
  } catch(e){ console.error(e); }

  if(!datos || !datos.nombre){
    document.getElementById('loading').style.display = 'none';
    document.getElementById('errorMsg').textContent =
      'No se encontraron datos en localStorage.landingData. Abre esta página desde el generador.';
    document.getElementById('errorBox').classList.add('show');
    return;
  }

  negocioActual = datos;
  iniciarPantalla(datos);
});

/* ==========================================================
   INICIO: muestra loading, luego la pantalla de pedidos
   ========================================================== */
function iniciarPantalla(n){
  var nn = nombreVisible(n.nombre);
  document.title = nn + ' · Pedidos';

  // Loading con logo / nombre / slogan
  var logo = document.getElementById('loadLogo');
  if(n.logo && esUrlImagen(n.logo)) logo.src = n.logo;
  else logo.style.display = 'none';

  document.getElementById('loadNombre').textContent = nn;
  var sl = document.getElementById('loadSlogan');
  if(n.slogan) sl.textContent = n.slogan; else sl.style.display = 'none';

  // Render productos y banner
  renderizarPantalla(n);

  // Ocultar loading después de 2s y mostrar pantalla
  setTimeout(function(){
    var l = document.getElementById('loading');
    l.classList.add('saliendo');
    document.getElementById('pantalla').classList.add('activa');
    setTimeout(function(){ l.style.display = 'none'; }, 800);
  }, 2000);
}

/* ==========================================================
   RENDERIZADO (misma lógica de split('&') del original)
   ========================================================== */
var productos = [];

function renderizarPantalla(n){
  var nn = nombreVisible(n.nombre);
  var cp = n.colorPrimario || '#7B2FF7';
  var cs = n.colorSecundario || '#FF00E5';
  var ca = n.colorAcento || '#00D4FF';

  document.documentElement.style.setProperty('--brand', cp);
  document.documentElement.style.setProperty('--brand-2', cs);
  document.documentElement.style.setProperty('--accent', ca);

  // Banner
  var b = document.getElementById('banner');
  if(n.banner && esUrlImagen(n.banner)){
    b.style.backgroundImage = "url('" + n.banner.replace(/'/g, "%27") + "')";
  }

  // Descripción (usa la parte larga después del &)
  var dp = (n.descripcion || '').split('&');
  var dc = dp[0].trim() || '';
  var dl = dp[1] ? dp[1].trim() : dc;
  var descEl = document.getElementById('descripcion');
  if(dl) descEl.textContent = dl;

  // Fotos → productos (formato original "nombre & precio")
  var fotos = (n.fotos || []).filter(function(f){ return f && f.url; });
  productos = fotos.map(function(f, i){
    var partes = (f.descripcion || '').split('&');
    var nombreProd = partes[0].trim() || ('Producto ' + (i+1));
    var precioRaw = partes[1] ? partes[1].trim() : '';
    if(precioRaw && !/^\$/.test(precioRaw)) precioRaw = '$' + precioRaw;
    var precioNum = parseFloat(String(precioRaw).replace(/[^0-9.]/g, '')) || 0;
    return { indice:i, nombre:nombreProd, precioTexto:precioRaw || '—', precio:precioNum, url:f.url };
  });

  // Placeholder SVG (idéntico al original)
  var phSVG = 'data:image/svg+xml;utf8,' + encodeURIComponent(
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 240">' +
    '<defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1">' +
    '<stop offset="0" stop-color="#1A2033"/><stop offset="1" stop-color="#0E1220"/>' +
    '</linearGradient></defs>' +
    '<rect width="300" height="240" fill="url(#g)"/>' +
    '<rect x="10" y="10" width="280" height="220" rx="18" fill="none" stroke="' + cp + '" stroke-width="3" stroke-dasharray="10 8"/>' +
    '<text x="150" y="105" font-size="48" text-anchor="middle">📦</text>' +
    '<text x="150" y="148" font-size="21" font-weight="700" text-anchor="middle" fill="#E0E0E0" font-family="Arial,sans-serif">ESPACIO RESERVADO</text>' +
    '<text x="150" y="175" font-size="17" text-anchor="middle" fill="' + ca + '" font-family="Arial,sans-serif">a nuevos productos</text>' +
    '</svg>'
  );

  // Relleno hasta 4 (misma lógica original)
  var relleno = productos.length < 4 ? 4 - productos.length : (productos.length % 2 ? 1 : 0);
  var placeholdersHTML = Array.apply(null, {length:relleno}).map(function(){
    return '<div class="prod prod-ph"><img src="' + phSVG + '" alt="Espacio reservado a nuevos productos" loading="lazy"></div>';
  }).join('');

  var filas = Math.max(1, Math.ceil((productos.length + relleno) / 2));
  var cat = document.getElementById('catalogo');
  cat.style.setProperty('--filas', filas);
  cat.innerHTML = productos.map(function(p){
    return '<div class="prod" data-idx="' + p.indice + '" onclick="abrirProducto(' + p.indice + ')">' +
      '<span class="prod-badge" id="badge-' + p.indice + '"></span>' +
      '<img src="' + escHTML(p.url) + '" alt="' + escHTML(p.nombre) + '" loading="lazy">' +
      '<div class="prod-info">' +
        '<div class="prod-nombre">' + escHTML(p.nombre) + '</div>' +
        '<div class="prod-precio">' + escHTML(p.precioTexto) + '</div>' +
      '</div>' +
    '</div>';
  }).join('') + placeholdersHTML;
}

/* ==========================================================
   CARRITO
   ========================================================== */
var carrito = {};
var prodActual = 0;
var ubicacionConfirmada = false;
var latPedido = null, lngPedido = null;
var ubiMapa = null, ubiMarcador = null, ubiLat = null, ubiLng = null;

window.abrirProducto = function(i){
  var p = productos[i];
  if(!p) return;
  prodActual = i;
  document.getElementById('mpImg').src = p.url;
  document.getElementById('mpNombre').textContent = p.nombre;
  document.getElementById('mpPrecio').textContent = p.precioTexto;
  document.getElementById('mpCant').textContent = carrito[i] || 0;
  document.getElementById('mpSub').textContent = 'Total: $' + ((carrito[i] || 0) * p.precio);
  document.getElementById('modalProducto').classList.add('activo');
};
window.cerrarProducto = function(){
  document.getElementById('modalProducto').classList.remove('activo');
};
window.pedidoSumar = function(i){ carrito[i] = (carrito[i] || 0) + 1; actualizarCant(i); };
window.pedidoRestar = function(i){ if(!carrito[i]) return; carrito[i]--; if(carrito[i] <= 0) delete carrito[i]; actualizarCant(i); };

function actualizarCant(i){
  var c = carrito[i] || 0;
  var b = document.getElementById('badge-' + i);
  if(b){ b.textContent = c; b.classList.toggle('on', c > 0); }
  if(prodActual === i && document.getElementById('modalProducto').classList.contains('activo')){
    var p = productos[i];
    document.getElementById('mpCant').textContent = c;
    document.getElementById('mpSub').textContent = 'Total: $' + (c * p.precio);
  }
  actualizarBotonUnico();
}

function actualizarBotonUnico(){
  var total = 0, items = 0;
  for(var k in carrito){
    var p = productos[parseInt(k)];
    if(!p) continue;
    items += carrito[k];
    total += p.precio * carrito[k];
  }
  document.getElementById('totalMonto').textContent = '$' + total;
  document.getElementById('totalItems').textContent = items > 0
    ? items + (items === 1 ? ' producto' : ' productos')
    : 'Aún no agregas productos';
  document.getElementById('buLinea2').textContent = ubicacionConfirmada
    ? '✅ Enviar pedido por WhatsApp'
    : '📍 Activar mi ubicación';
  document.getElementById('btnUnico').classList.toggle('estado-enviar', ubicacionConfirmada);
}

window.accionBotonUnico = function(){
  var total = 0;
  for(var k in carrito) total += carrito[k];
  if(total === 0){ alert('🛒 Agrega al menos un producto primero'); return; }
  if(!ubicacionConfirmada){ abrirUbiModal(); }
  else { abrirModalPedido(); }
};

/* ==========================================================
   UBICACIÓN
   ========================================================== */
window.abrirUbiModal = function(){
  document.getElementById('ubiModal').classList.add('activo');
  setTimeout(function(){
    if(!ubiMapa) inicializarUbiMapa();
    else ubiMapa.invalidateSize();
  }, 200);
};
window.cerrarUbiModal = function(){
  document.getElementById('ubiModal').classList.remove('activo');
};

function inicializarUbiMapa(){
  var latIni = 20.5888, lngIni = -100.3899;
  ubiMapa = L.map('ubiMapa', { center:[latIni, lngIni], zoom:15 });
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom:19 }).addTo(ubiMapa);
  ubiMarcador = L.marker([latIni, lngIni], { draggable:true }).addTo(ubiMapa);
  ubiLat = latIni; ubiLng = lngIni;
  ubiMarcador.on('dragend', function(){
    var p = ubiMarcador.getLatLng();
    ubiLat = p.lat; ubiLng = p.lng; ubiEstadoPin();
  });
  ubiMapa.on('click', function(e){
    ubiMarcador.setLatLng(e.latlng);
    ubiLat = e.latlng.lat; ubiLng = e.latlng.lng;
    ubiEstadoPin();
  });
  ubiUsarGPS();
}

window.ubiUsarGPS = function(){
  var el = document.getElementById('ubiEstado');
  if(!navigator.geolocation){ el.textContent = '❌ Tu navegador no soporta GPS. Toca el mapa.'; el.classList.remove('ok'); return; }
  el.textContent = '⏳ Obteniendo tu ubicación...'; el.classList.remove('ok');
  navigator.geolocation.getCurrentPosition(
    function(pos){
      ubiLat = pos.coords.latitude; ubiLng = pos.coords.longitude;
      if(ubiMapa){ ubiMapa.setView([ubiLat, ubiLng], 17); ubiMarcador.setLatLng([ubiLat, ubiLng]); }
      ubiEstadoPin();
    },
    function(err){
      var msg = '⚠️ No se pudo obtener tu ubicación. Toca el mapa para marcar.';
      if(err && err.code === 1) msg = '⚠️ Permiso denegado. Actívalo o toca el mapa.';
      else if(err && err.code === 2) msg = '⚠️ Ubicación no disponible. Toca el mapa.';
      else if(err && err.code === 3) msg = '⚠️ Tiempo agotado. Toca el mapa.';
      el.textContent = msg; el.classList.remove('ok');
    },
    { enableHighAccuracy:true, timeout:10000, maximumAge:0 }
  );
};

function ubiEstadoPin(){
  var el = document.getElementById('ubiEstado');
  var btn = document.getElementById('ubiConfirmar');
  if(ubiLat && ubiLng){
    el.textContent = '✅ Ubicación marcada: ' + ubiLat.toFixed(5) + ', ' + ubiLng.toFixed(5);
    el.classList.add('ok');
    btn.disabled = false;
  }
}

window.ubiConfirmarUbicacion = function(){
  if(!ubiLat || !ubiLng){ alert('Marca tu ubicación en el mapa'); return; }
  latPedido = ubiLat; lngPedido = ubiLng;
  ubicacionConfirmada = true;
  actualizarBotonUnico();
  cerrarUbiModal();
  alert('✅ Ubicación confirmada. Ya puedes enviar tu pedido.');
};

/* ==========================================================
   PEDIDO (mismo formato de mensaje del original)
   ========================================================== */
window.abrirModalPedido = function(){
  actualizarResumen();
  document.getElementById('clienteNombre').value = '';
  document.getElementById('modalPedido').classList.add('activo');
};
window.cerrarModalPedido = function(){
  document.getElementById('modalPedido').classList.remove('activo');
};

function actualizarResumen(){
  var html = '<strong>📦 Tu pedido:</strong><br>';
  var total = 0;
  for(var k in carrito){
    var p = productos[parseInt(k)];
    if(!p) continue;
    var sub = p.precio * carrito[k];
    total += sub;
    html += '• ' + carrito[k] + 'x ' + p.nombre + ' — $' + sub + '<br>';
  }
  document.getElementById('resumenPedido').innerHTML = html;
  document.getElementById('resumenTotal').textContent = '💰 Total: $' + total;
}

function obtenerClienteId(){
  var cid = localStorage.getItem('clienteId');
  if(!cid){ cid = 'CLI-' + Date.now() + '-' + Math.random().toString(36).slice(2,8); localStorage.setItem('clienteId', cid); }
  return cid;
}

window.confirmarPedido = function(){
  var nombre = (document.getElementById('clienteNombre').value || '').trim();
  if(!nombre){ alert('✍️ Escribe tu nombre'); return; }
  if(!ubicacionConfirmada || !latPedido || !lngPedido){ alert('📍 Primero confirma tu ubicación'); return; }

  var items = []; var total = 0;
  for(var k in carrito){
    var p = productos[parseInt(k)];
    if(!p) continue;
    var cant = carrito[k]; var sub = p.precio * cant;
    total += sub;
    items.push('• ' + cant + 'x ' + p.nombre + ' — $' + sub);
  }
  if(items.length === 0){ alert('No hay productos en el pedido'); return; }

  // WhatsApp: misma lógica original (10 dígitos → agregar 52)
  var wd = String(negocioActual.whatsapp || '').replace(/\D/g, '');
  if(wd.length === 10) wd = '52' + wd;

  var clienteId = obtenerClienteId();
  var ahora = new Date();
  var fecha = ahora.toLocaleDateString('es-MX') + ' ' + ahora.toLocaleTimeString('es-MX', { hour:'2-digit', minute:'2-digit' });

  var resumen = '📦 Revisa tu pedido:\n\n' + items.join('\n') + '\n\n💰 TOTAL: $' + total + '\n\n👤 ' + nombre + '\n📍 Ubicación confirmada\n\n¿Enviar por WhatsApp al negocio?';
  if(!confirm(resumen)) return;

  var msg = '🛒 NUEVO PEDIDO\n━━━━━━━━━━━━━━━\n🏪 ' + nombreVisible(negocioActual.nombre) + '\n🆔 Negocio ID: ' + (negocioActual.id || '-') + '\n━━━━━━━━━━━━━━━\n👤 Cliente: ' + nombre + '\n🔖 Cliente ID: ' + clienteId + '\n📍 Ubicación: https://maps.google.com/?q=' + latPedido + ',' + lngPedido + '\n🕐 ' + fecha + '\n━━━━━━━━━━━━━━━\n📦 DETALLE:\n' + items.join('\n') + '\n━━━━━━━━━━━━━━━\n💰 TOTAL: $' + total;

  window.open('https://wa.me/' + wd + '?text=' + encodeURIComponent(msg), '_blank');
};

actualizarBotonUnico();
</script>
</body>
</html>
