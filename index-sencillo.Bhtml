      </div>
    </div>
    <iframe id="previewFrame" class="preview-frame" sandbox="allow-scripts"></iframe>
  </div>
</div>
  
<!-- Modal de Detalle -->
<div class="modal-overlay" id="detailOverlay">
  <div class="modal detail-modal" style="position:relative;">
    <button class="detail-close" onclick="cerrarDetalle()">&times;</button>
    <div class="detail-banner-wrap">
      <div class="detail-banner" id="detailBanner">
        <div class="detail-banner-inner">
          <img class="detail-logo" id="detailLogoImg" style="display:none;">
