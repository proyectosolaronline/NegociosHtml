</div>

<!-- Popup Mapa -->
<div class="modal-overlay" id="mapPopupOverlay">
  <div class="modal map-popup-modal">
    <div class="modal-header"><h2>📍 Ubicación</h2><button class="modal-close" onclick="cerrarMapaPopup()">&times;</button></div>
    <div id="detailMap"></div>
    <p style="margin-top:10px;font-size:13px;color:#666;" id="detailMapDireccion"></p>
    <a href="#" target="_blank" class="btn btn-success" style="width:100%;justify-content:center;margin-top:14px;" id="detailBtnComoLlegar">🧭 Cómo llegar</a>
  </div>
</div>

<iframe name="hiddenSaveFrame" style="display:none;"></iframe>
<form id="hiddenSaveForm" method="POST" target="hiddenSaveFrame" style="display:none;">
  <input type="hidden" name="action" id="hf_action">
  <input type="hidden" name="id" id="hf_id">
  <input type="hidden" name="datos" id="hf_datos">
</form>

<a href="https://proyectosolaronline.github.io/NegociosHtml/mariscos-la-kachora.html" target="_blank" class="fab-admin">⚙️</a>

<script>
// ============================================================
// CONFIGURACIÓN
// ============================================================
const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbzZU47U-mGAPq9nF1WwqsIYdXsx9CQE1cnpJP7Rd7_g2fc3nUskq5jdqe0o4nAxMGU_LQ/exec';
const GITHUB_PUBLISH_URL = 'https://script.google.com/macros/s/AKfycbwh4EBEepNZrWVibk7L4jq3KZHx9ly_tFsF7OjFDInt6GS-gjdiQcWVrd83tzLNp-aKSw/exec';

let negocios = [];
let map = null;
let marker = null;
let ubicacionSeleccionada = false;
let fotosSeleccionadas = [null, null, null, null];
let currentPreviewHTML = '';
let currentPreviewNombre = '';
let currentPreviewId = '';
let videoSeleccionado = null;

// ============================================================
// INICIALIZACIÓN
// ============================================================
document.addEventListener('DOMContentLoaded', function() {
  console.log('🚀 App iniciada');
  inicializarMapa();
  generarSlotsFotos();
  switchVideoTab('url');
  const esModoCliente = verificarModoClienteEdicion();
  if (!esModoCliente) cargarNegocios();
});

// ============================================================
// API CALLS
// ============================================================
function callAPI(action, params = {}) {
  return new Promise((resolve, reject) => {
    const callbackName = 'cb_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
    window[callbackName] = function(result) {
      delete window[callbackName];
      document.body.removeChild(script);
      resolve(result);
    };
    let url = `${APPS_SCRIPT_URL}?action=${action}&callback=${callbackName}`;
    for (const key in params) {
      url += `&${key}=${encodeURIComponent(typeof params[key] === 'object' ? JSON.stringify(params[key]) : params[key])}`;
    }
    const script = document.createElement('script');
    script.src = url;
    script.onerror = function() { delete window[callbackName]; document.body.removeChild(script); reject(new Error('Error de conexión')); };
    document.body.appendChild(script);
  });
}

// ============================================================
// CARGAR NEGOCIOS
// ============================================================
async function cargarNegocios() {
  showLoading();
  try {
    const result = await callAPI('obtenerNegocios');
    hideLoading();
    if (result.success) {
      negocios = result.negocios || [];
      renderizarLista();
    } else {
      showToast('Error: ' + result.error, 'error');
    }
  } catch(e) { hideLoading(); showToast('Error de conexión', 'error'); }
}

function showLoading() { document.getElementById('loadingOverlay').classList.add('active'); }
function hideLoading() { document.getElementById('loadingOverlay').classList.remove('active'); }

// ============================================================
// RENDERIZAR LISTA
// ============================================================
function renderizarLista() {
  const body = document.getElementById('negociosListBody');
  const searchTerm = document.getElementById('searchInput').value.toLowerCase();
  const filtrados = negocios.filter(n => 
    (n.nombre||'').toLowerCase().includes(searchTerm) ||
    (n.id||'').toLowerCase().includes(searchTerm)
  );
  document.getElementById('contador').textContent = `Mostrando ${filtrados.length} de ${negocios.length}`;
  if (filtrados.length === 0) {
    body.innerHTML = '<div class="sheet-empty-state">📭 No se encontraron negocios</div>';
    return;
  }
  body.innerHTML = filtrados.map(n => `
    <div class="sheet-row" onclick="abrirDetalle('${n.id}')">
      <span class="sheet-cell-id">${n.id||'-'}</span>
      <span class="sheet-cell-nombre">${n.nombre||'-'}</span>
      <span class="sheet-cell-desc">${n.descripcion||''}</span>
      ${n.logo ? `<img src="${n.logo}" class="sheet-mini-logo">` : `<span class="sheet-mini-empty">🏪</span>`}
      ${n.banner ? `<img src="${n.banner}" class="sheet-mini-banner">` : `<span class="sheet-mini-empty">🖼️</span>`}
    </div>
  `).join('');
}

function filtrarNegocios() { renderizarLista(); }

// ============================================================
// MAPA
// ============================================================
function inicializarMapa() {
  map = L.map('map', { center: [20.5888, -100.3899], zoom: 13, zoomControl: false });
  L.control.zoom({ position: 'topright' }).addTo(map);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap', maxZoom: 19 }).addTo(map);
  if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition((pos) => {
      map.setView([pos.coords.latitude, pos.coords.longitude], 15);
      colocarMarcador(pos.coords.latitude, pos.coords.longitude);
    }, () => {});
  }
  map.on('click', function(e) { colocarMarcador(e.latlng.lat, e.latlng.lng); });
}

function colocarMarcador(lat, lng) {
  if (marker) map.removeLayer(marker);
  marker = L.marker([lat, lng], { draggable: true }).addTo(map);
  document.getElementById('latitud').value = lat.toFixed(6);
  document.getElementById('longitud').value = lng.toFixed(6);
  ubicacionSeleccionada = true;
  document.getElementById('mapStatus').textContent = '✅ Ubicación confirmada';
  document.getElementById('mapStatus').className = 'map-status confirmed';
}

function setUbicacionEnMapa(lat, lng) {
  if (!lat || !lng) return;
  map.setView([parseFloat(lat), parseFloat(lng)], 16);
  colocarMarcador(parseFloat(lat), parseFloat(lng));
}

function abrirMapaPantallaCompleta() {
  var mapContainer = document.getElementById('map');
  if (!document.fullscreenElement) { mapContainer.requestFullscreen(); } else { document.exitFullscreen(); }
}

// ============================================================
// FOTOS
// ============================================================
function generarSlotsFotos() {
  const grid = document.getElementById('fotosGrid');
  grid.innerHTML = '';
  for (let i = 0; i < 4; i++) {
    const foto = fotosSeleccionadas[i];
    const card = document.createElement('div');
    card.className = 'foto-card' + (foto ? ' has-foto' : '');
    card.style.position = 'relative';
    card.onclick = function(e) { if (!e.target.classList.contains('btn-remove-foto') && e.target.tagName !== 'TEXTAREA') abrirSelectorFoto(i); };
    card.innerHTML = foto ? `
      <button class="btn-remove-foto" onclick="event.stopPropagation();removerFoto(${i})">×</button>
      <img src="${foto.url}" alt="Foto ${i+1}">
      <textarea class="foto-desc" placeholder="Título & Descripción" oninput="actualizarDescFoto(${i},this.value)" onclick="event.stopPropagation();">${foto.descripcion||''}</textarea>
    ` : `<div class="placeholder">📷</div><div class="foto-label">Foto ${i+1}</div>`;
    grid.appendChild(card);
  }
}

function mostrarMenuFoto(callback) {
  const overlay = document.createElement('div');
  overlay.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:5000;display:flex;align-items:flex-end;justify-content:center;';
  overlay.innerHTML = `
    <div style="background:white;border-radius:16px 16px 0 0;padding:20px;width:100%;max-width:400px;">
      <button id="menuFotoCamara" style="width:100%;padding:14px;margin-bottom:10px;background:#667eea;color:white;border:none;border-radius:10px;font-weight:600;">📷 Tomar foto</button>
      <button id="menuFotoGaleria" style="width:100%;padding:14px;margin-bottom:10px;background:#28a745;color:white;border:none;border-radius:10px;font-weight:600;">🖼️ Elegir de galería</button>
      <button id="menuFotoCancelar" style="width:100%;padding:14px;background:#f0f0f0;color:#333;border:none;border-radius:10px;font-weight:600;">Cancelar</button>
    </div>`;
  document.body.appendChild(overlay);
  overlay.querySelector('#menuFotoCamara').onclick = function() { document.body.removeChild(overlay); callback(true); };
  overlay.querySelector('#menuFotoGaleria').onclick = function() { document.body.removeChild(overlay); callback(false); };
  overlay.querySelector('#menuFotoCancelar').onclick = function() { document.body.removeChild(overlay); };
}

function abrirSelectorFoto(index) {
  mostrarMenuFoto(function(desdeCamara) {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'image/*';
    if (desdeCamara) input.capture = 'environment';
    input.onchange = function(e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(ev) {
        const img = new Image();
        img.onload = function() {
          const MAX_DIM = 900;
          let w = img.width, h = img.height;
          if (w > h && w > MAX_DIM) { h = Math.round(h * MAX_DIM / w); w = MAX_DIM; }
          else if (h > MAX_DIM) { w = Math.round(w * MAX_DIM / h); h = MAX_DIM; }
          const canvas = document.createElement('canvas');
          canvas.width = w; canvas.height = h;
          canvas.getContext('2d').drawImage(img, 0, 0, w, h);
          let calidad = 0.7;
          let dataUrl = canvas.toDataURL('image/jpeg', calidad);
          while (dataUrl.length > 45000 && calidad > 0.2) { calidad -= 0.1; dataUrl = canvas.toDataURL('image/jpeg', calidad); }
          fotosSeleccionadas[index] = { url: dataUrl, descripcion: fotosSeleccionadas[index]?.descripcion || '' };
          generarSlotsFotos();
        };
        img.src = ev.target.result;
      };
      reader.readAsDataURL(file);
    };
    input.click();
  });
}
function removerFoto(index) { fotosSeleccionadas[index] = null; generarSlotsFotos(); }
function actualizarDescFoto(index, valor) { if (fotosSeleccionadas[index]) fotosSeleccionadas[index].descripcion = valor; }

function seleccionarImagenLogoBanner(campoId, previewId) {
  mostrarMenuFoto(function(desdeCamara) {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'image/*';
    if (desdeCamara) input.capture = 'environment';
    input.onchange = function() {
      const file = input.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        const img = new Image();
        img.onload = function() {
          const MAX = 500;
          let w = img.width, h = img.height;
          if (w > h && w > MAX) { h = Math.round(h * MAX / w); w = MAX; }
          else if (h > MAX) { w = Math.round(w * MAX / h); h = MAX; }
          const canvas = document.createElement('canvas');
          canvas.width = w; canvas.height = h;
          canvas.getContext('2d').drawImage(img, 0, 0, w, h);
          const dataUrl = canvas.toDataURL('image/jpeg', 0.6);
          document.getElementById(campoId).value = dataUrl;
          document.getElementById(previewId).src = dataUrl;
          document.getElementById(previewId).style.display = 'block';
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    };
    input.click();
  });
}

// ============================================================
// 🎬 FUNCIONES DE VIDEO
// ============================================================
function switchVideoTab(tab) {
  const panelUrl = document.getElementById('panelVideoUrl');
  const panelGaleria = document.getElementById('panelVideoGaleria');
  const tabUrl = document.getElementById('tabVideoUrl');
  const tabGaleria = document.getElementById('tabVideoGaleria');
  if (!panelUrl || !panelGaleria || !tabUrl || !tabGaleria) return;
  
  if (tab === 'url') {
    panelUrl.style.display = 'block';
    panelGaleria.style.display = 'none';
    tabUrl.className = 'btn btn-primary btn-sm';
    tabGaleria.className = 'btn btn-outline btn-sm';
    tabGaleria.style.borderColor = '#667eea';
    tabGaleria.style.color = '#667eea';
  } else {
    panelUrl.style.display = 'none';
    panelGaleria.style.display = 'block';
    tabUrl.className = 'btn btn-outline btn-sm';
    tabUrl.style.borderColor = '#667eea';
    tabUrl.style.color = '#667eea';
    tabGaleria.className = 'btn btn-primary btn-sm';
  }
}

function seleccionarVideoGaleria() {
  const input = document.createElement('input');
  input.type = 'file';
  input.accept = 'video/*';
  input.onchange = function(e) {
    const file = e.target.files[0];
    if (!file) return;
    const MAX_SIZE = 50 * 1024 * 1024;
    if (file.size > MAX_SIZE) { showToast('❌ El video es muy grande (máximo 50 MB)', 'error'); return; }
    const formatosAceptados = ['video/mp4', 'video/webm', 'video/quicktime', 'video/ogg'];
    if (!formatosAceptados.includes(file.type)) { showToast('❌ Formato no soportado', 'error'); return; }
    const reader = new FileReader();
    reader.onload = function(ev) {
      const base64 = ev.target.result.split(',')[1];
      videoSeleccionado = { base64: base64, fileName: file.name, mimeType: file.type || 'video/mp4', size: file.size };
      const videoPreview = document.getElementById('videoFilePreview');
      videoPreview.src = URL.createObjectURL(file);
      document.getElementById('videoFilePreviewContainer').style.display = 'block';
      document.getElementById('videoFileInfo').textContent = file.name + ' · ' + formatBytes(file.size);
      document.getElementById('btnQuitarVideo').style.display = 'block';
      showToast('✅ Video seleccionado: ' + file.name, 'success');
    };
    reader.readAsDataURL(file);
  };
  input.click();
}

function quitarVideoGaleria() {
  videoSeleccionado = null;
  const videoPreview = document.getElementById('videoFilePreview');
  URL.revokeObjectURL(videoPreview.src);
  videoPreview.src = '';
  document.getElementById('videoFilePreviewContainer').style.display = 'none';
  document.getElementById('videoFileInfo').textContent = '';
  document.getElementById('btnQuitarVideo').style.display = 'none';
  showToast('🗑️ Video eliminado', 'success');
}

function extraerYouTubeIdFront(url) {
  if (!url || typeof url !== 'string') return null;
  const patterns = [
    /youtube\.com\/watch\?v=([\w-]{11})/,
    /youtu\.be\/([\w-]{11})/,
    /youtube\.com\/shorts\/([\w-]{11})/,
    /youtube\.com\/embed\/([\w-]{11})/,
    /youtube\.com\/v\/([\w-]{11})/,
    /youtube\.com\/live\/([\w-]{11})/
  ];
  for (const pattern of patterns) {
    const match = url.match(pattern);
    if (match) return match[1];
  }
  return null;
}

function previsualizarVideo(url) {
  const container = document.getElementById('videoPreview');
  const previewContainer = document.getElementById('videoPreviewContainer');
  if (!container || !previewContainer) return;
  if (!url || !url.trim()) {
    previewContainer.style.display = 'none';
    container.innerHTML = '';
    return;
  }
  const youtubeId = extraerYouTubeIdFront(url);
  if (youtubeId) {
    container.innerHTML = '<iframe src="https://www.youtube.com/embed/' + youtubeId + '?rel=0" allow="autoplay; encrypted-media; fullscreen" allowfullscreen style="position:absolute;top:0;left:0;width:100%;height:100%;border:none;border-radius:10px;"></iframe>';
    previewContainer.style.display = 'block';
  } else {
    container.innerHTML = '<video controls preload="metadata" style="position:absolute;top:0;left:0;width:100%;height:100%;border-radius:10px;background:#000;"><source src="' + url + '" type="video/mp4"></video>';
    previewContainer.style.display = 'block';
  }
}

function formatBytes(bytes) {
  if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
  return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
}

// ============================================================
// ABRIR MODALES
// ============================================================
function abrirModalNuevo() {
  document.getElementById('modalTitle').textContent = '➕ Nuevo Negocio';
  document.getElementById('btnGuardar').textContent = '💾 Guardar Negocio';
  document.getElementById('editId').value = '';
  document.getElementById('formNegocio').reset();
  document.getElementById('activo').value = 'true';
  document.getElementById('rol').value = 'Admin';
  fotosSeleccionadas = [null, null, null, null];
  ubicacionSeleccionada = false;
  if (marker) { map.removeLayer(marker); marker = null; }
  generarSlotsFotos();
  document.getElementById('logo').value = '';
  document.getElementById('banner').value = '';
  document.getElementById('logoPreview').style.display = 'none';
  document.getElementById('bannerPreview').style.display = 'none';
  videoSeleccionado = null;
  document.getElementById('videoUrl').value = '';
  document.getElementById('videoPreviewContainer').style.display = 'none';
  document.getElementById('videoPreview').innerHTML = '';
  document.getElementById('videoFilePreviewContainer').style.display = 'none';
  document.getElementById('btnQuitarVideo').style.display = 'none';
  switchVideoTab('url');
  document.getElementById('modalOverlay').classList.add('active');
  setTimeout(() => { if (map) map.invalidateSize(); }, 300);
}

function abrirModalEditar(id) {
  const negocio = negocios.find(n => n.id === id);
  if (!negocio) { showToast('Negocio no encontrado', 'error'); return; }
  document.getElementById('modalTitle').textContent = '✏️ Editar Negocio';
  document.getElementById('btnGuardar').textContent = '💾 Actualizar';
  document.getElementById('editId').value = id;
  document.getElementById('usuario').value = negocio.usuario || '';
  document.getElementById('password').value = negocio.password || '';
  document.getElementById('nombre').value = negocio.nombre || '';
  document.getElementById('slogan').value = negocio.slogan || '';
  document.getElementById('descripcion').value = negocio.descripcion || '';
  document.getElementById('mision').value = negocio.mision || '';
  document.getElementById('mensajeEmergente').value = negocio.mensajeEmergente || '';
  document.getElementById('ubicacion').value = negocio.ubicacion || '';
  document.getElementById('direccion').value = negocio.direccion || '';
  document.getElementById('latitud').value = negocio.latitud || '';
  document.getElementById('longitud').value = negocio.longitud || '';
  document.getElementById('telefono').value = negocio.telefono || '';
  document.getElementById('whatsapp').value = negocio.whatsapp || '';
  document.getElementById('correo').value = negocio.correo || '';
  document.getElementById('horario').value = negocio.horario || '';
  document.getElementById('rol').value = negocio.rol || 'Admin';
  document.getElementById('urlFacebook').value = negocio.urlFacebook || '';
  document.getElementById('activo').value = negocio.activo ? 'true' : 'false';
  document.getElementById('duenoMensaje').value = negocio.duenoMensaje || '';
  document.getElementById('duenoTelefono').value = negocio.duenoTelefono || '';
  document.getElementById('duenoCorreo').value = negocio.duenoCorreo || '';
  document.getElementById('colorPrimario').value = negocio.colorPrimario || '#667eea';
  document.getElementById('colorSecundario').value = negocio.colorSecundario || '#764ba2';
  document.getElementById('colorAcento').value = negocio.colorAcento || '#fbbf24';
  
  fotosSeleccionadas = [null, null, null, null];
  if (negocio.fotos) negocio.fotos.forEach((f, i) => { if (i < 4 && f && f.url) fotosSeleccionadas[i] = { url: f.url, descripcion: f.descripcion || '' }; });
  
  document.getElementById('logo').value = negocio.logo || '';
  if (negocio.logo) { document.getElementById('logoPreview').src = negocio.logo; document.getElementById('logoPreview').style.display = 'block'; }
  else { document.getElementById('logoPreview').style.display = 'none'; }
  document.getElementById('banner').value = negocio.banner || '';
  if (negocio.banner) { document.getElementById('bannerPreview').src = negocio.banner; document.getElementById('bannerPreview').style.display = 'block'; }
  else { document.getElementById('bannerPreview').style.display = 'none'; }
  
  videoSeleccionado = null;
  const videoUrl = negocio.video?.url || negocio.video || '';
  document.getElementById('videoUrl').value = videoUrl;
  document.getElementById('videoFilePreviewContainer').style.display = 'none';
  document.getElementById('btnQuitarVideo').style.display = 'none';
  
  if (videoUrl) {
    if (videoUrl.startsWith('data:video/') || videoUrl.startsWith('data:application/')) {
      videoSeleccionado = { base64: videoUrl.split(',')[1] || videoUrl, fileName: 'video_guardado.mp4', mimeType: 'video/mp4' };
      const videoPreview = document.getElementById('videoFilePreview');
      videoPreview.src = videoUrl;
      document.getElementById('videoFilePreviewContainer').style.display = 'block';
      document.getElementById('videoFileInfo').textContent = 'Video guardado previamente';
      document.getElementById('btnQuitarVideo').style.display = 'block';
      switchVideoTab('galeria');
    } else {
      previsualizarVideo(videoUrl);
      switchVideoTab('url');
    }
  } else {
    switchVideoTab('url');
  }
  
  if (negocio.latitud && negocio.longitud) { setUbicacionEnMapa(negocio.latitud, negocio.longitud); ubicacionSeleccionada = true; }
  generarSlotsFotos();
  document.getElementById('modalOverlay').classList.add('active');
  setTimeout(() => { if (map) map.invalidateSize(); }, 300);
}

function cerrarModal() { document.getElementById('modalOverlay').classList.remove('active'); }

// ============================================================
// DETALLE
// ============================================================
let detailMapInstance = null;
let detailMapMarker = null;

function abrirDetalle(id) {
  const negocio = negocios.find(n => n.id === id);
  if (!negocio) return;
  document.getElementById('detailBanner').style.backgroundImage = negocio.banner ? `url('${negocio.banner}')` : 'none';
  if (negocio.logo) {
    document.getElementById('detailLogoImg').src = negocio.logo;
    document.getElementById('detailLogoImg').style.display = 'block';
    document.getElementById('detailLogoPlaceholder').style.display = 'none';
  } else {
    document.getElementById('detailLogoImg').style.display = 'none';
    document.getElementById('detailLogoPlaceholder').style.display = 'flex';
  }
  document.getElementById('detailNombre').textContent = negocio.nombre || '';
  document.getElementById('detailDescripcion').textContent = negocio.descripcion || '';
  const sloganEl = document.getElementById('detailSlogan');
  sloganEl.textContent = negocio.slogan ? '✨ ' + negocio.slogan : '';
  sloganEl.style.display = negocio.slogan ? 'block' : 'none';
  const fotos = (negocio.fotos || []).filter(f => f && f.url);
  document.getElementById('detailGallery').innerHTML = fotos.map(f => `<img src="${f.url}">`).join('');
  document.getElementById('detailGallery').style.display = fotos.length ? 'grid' : 'none';
  const contactos = [
    ['📞 Teléfono', negocio.telefono], ['💬 WhatsApp', negocio.whatsapp],
    ['🕐 Horario', negocio.horario], ['✉️ Correo', negocio.correo],
    ['📍 Dirección', negocio.direccion || negocio.ubicacion]
  ].filter(([, valor]) => valor);
  document.getElementById('detailContact').innerHTML = contactos.map(([label, valor]) => `
    <div class="detail-contact-item"><div class="dc-label">${label}</div><div class="dc-valor">${valor}</div></div>
  `).join('');
  document.getElementById('detailBtnMapa').style.display = (negocio.latitud && negocio.longitud) ? 'inline-flex' : 'none';
  document.getElementById('detailBtnMapa').onclick = () => abrirMapaPopup(negocio);
  document.getElementById('detailBtnLanding').onclick = () => { cerrarDetalle(); previsualizarLanding(negocio.id); };
  document.getElementById('detailBtnEditar').onclick = () => { cerrarDetalle(); abrirModalEditar(negocio.id); };
  document.getElementById('detailBtnEliminar').onclick = () => eliminarNegocio(negocio.id);
  document.getElementById('detailOverlay').classList.add('active');
}

function cerrarDetalle() { document.getElementById('detailOverlay').classList.remove('active'); }

function abrirMapaPopup(negocio) {
  document.getElementById('detailMapDireccion').textContent = negocio.direccion || '';
  document.getElementById('detailBtnComoLlegar').href = `https://www.google.com/maps/dir/?api=1&destination=${negocio.latitud},${negocio.longitud}`;
  document.getElementById('mapPopupOverlay').classList.add('active');
  setTimeout(() => {
    if (!detailMapInstance) {
      detailMapInstance = L.map('detailMap');
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(detailMapInstance);
    }
    detailMapInstance.setView([parseFloat(negocio.latitud), parseFloat(negocio.longitud)], 16);
    if (detailMapMarker) detailMapInstance.removeLayer(detailMapMarker);
    detailMapMarker = L.marker([parseFloat(negocio.latitud), parseFloat(negocio.longitud)]).addTo(detailMapInstance);
    detailMapInstance.invalidateSize();
  }, 200);
}

function cerrarMapaPopup() { document.getElementById('mapPopupOverlay').classList.remove('active'); }

// ============================================================
// GUARDAR
// ============================================================
function postViaIframe(action, id, datos, targetUrl) {
  return new Promise((resolve, reject) => {
    let resuelto = false;
    function onMessage(e) {
      if (resuelto) return;
      if (e.data && typeof e.data === 'object' && 'success' in e.data) {
        resuelto = true;
        window.removeEventListener('message', onMessage);
        resolve(e.data);
      }
    }
    window.addEventListener('message', onMessage);
    document.getElementById('hf_action').value = action;
    document.getElementById('hf_id').value = id || '';
    document.getElementById('hf_datos').value = JSON.stringify(datos);
    const form = document.getElementById('hiddenSaveForm');
    form.action = targetUrl || APPS_SCRIPT_URL;
    form.submit();
    setTimeout(() => { if (!resuelto) { resuelto = true; window.removeEventListener('message', onMessage); reject(new Error('Timeout')); } }, 30000);
  });
}

async function guardarNegocio(event) {
  event.preventDefault();
  if (!ubicacionSeleccionada) { showToast('⚠️ Debes seleccionar una ubicación en el mapa', 'error'); return; }
  const editId = document.getElementById('editId').value;
  const btnGuardar = document.getElementById('btnGuardar');
  btnGuardar.disabled = true;
  btnGuardar.textContent = '⏳ Guardando...';
  
  const datos = {
    usuario: document.getElementById('usuario').value.trim(),
    password: document.getElementById('password').value.trim(),
    nombre: document.getElementById('nombre').value.trim(),
    slogan: document.getElementById('slogan').value.trim(),
    descripcion: document.getElementById('descripcion').value.trim(),
    mision: document.getElementById('mision').value.trim(),
    mensajeEmergente: document.getElementById('mensajeEmergente').value.trim(),
    ubicacion: document.getElementById('ubicacion').value.trim(),
    direccion: document.getElementById('direccion').value.trim(),
    latitud: document.getElementById('latitud').value,
    longitud: document.getElementById('longitud').value,
    telefono: document.getElementById('telefono').value.trim(),
    whatsapp: document.getElementById('whatsapp').value.trim(),
    correo: document.getElementById('correo').value.trim(),
    horario: document.getElementById('horario').value.trim(),
    rol: document.getElementById('rol').value,
    urlFacebook: document.getElementById('urlFacebook').value.trim(),
    activo: document.getElementById('activo').value === 'true',
    fotos: fotosSeleccionadas.filter(f => f && f.url),
    logo: document.getElementById('logo').value,
    banner: document.getElementById('banner').value,
    video: videoSeleccionado?.base64 ? 'data:video/mp4;base64,' + videoSeleccionado.base64 : document.getElementById('videoUrl').value.trim(),
    duenoMensaje: document.getElementById('duenoMensaje').value.trim(),
    duenoTelefono: document.getElementById('duenoTelefono').value.trim(),
    duenoCorreo: document.getElementById('duenoCorreo').value.trim(),
    colorPrimario: document.getElementById('colorPrimario').value,
    colorSecundario: document.getElementById('colorSecundario').value,
    colorAcento: document.getElementById('colorAcento').value,
    fuenteLanding: document.getElementById('fuenteLanding').value
  };
  
  if (!datos.usuario || !datos.password || !datos.nombre) {
    showToast('❌ Campos obligatorios faltantes', 'error');
    btnGuardar.disabled = false;
    btnGuardar.textContent = '💾 Guardar Negocio';
    return;
  }
  
  showLoading();
  try {
    const action = editId ? 'editarNegocio' : 'agregarNegocio';
    const result = await postViaIframe(action, editId, datos);
    hideLoading();
    btnGuardar.disabled = false;
    btnGuardar.textContent = '💾 Guardar Negocio';
    if (result.success) {
      showToast(editId ? '✅ Negocio actualizado' : '✅ Negocio creado - ID: ' + result.id, 'success');
      cerrarModal();
      cargarNegocios();
    } else {
      showToast('❌ Error: ' + (result.error || 'Desconocido'), 'error');
    }
  } catch(e) {
    hideLoading();
    btnGuardar.disabled = false;
    btnGuardar.textContent = '💾 Guardar Negocio';
    showToast('❌ Error de conexión', 'error');
  }
}

// ============================================================
// ELIMINAR
// ============================================================
async function eliminarNegocio(id) {
  if (!confirm('⚠️ ¿Eliminar este negocio?')) return;
  showLoading();
  try {
    const result = await callAPI('eliminarNegocio', { id });
    hideLoading();
    if (result.success) { showToast('✅ Negocio eliminado', 'success'); cargarNegocios(); }
    else showToast('❌ Error: ' + result.error, 'error');
  } catch(e) { hideLoading(); showToast('❌ Error de conexión', 'error'); }
}

// ============================================================
// LANDING PAGE
// ============================================================
function construirLandingHTML(n) {
  const whatsappDigits = String(n.whatsapp || '').replace(/\D/g, '');
  const telDigits = String(n.telefono || '').replace(/\D/g, '');
  const fotos = (n.fotos || []).filter(f => f && f.url);
  const tieneMapa = n.latitud && n.longitud;
  const colorPrimario = n.colorPrimario || '#667eea';
  const colorSecundario = n.colorSecundario || '#764ba2';
  const colorAcento = n.colorAcento || '#fbbf24';
  const descParts = (n.descripcion || '').split('&');
  const descLarga = descParts[1] ? descParts[1].trim() : (descParts[0] || '').trim();
  
  const videoData = n.video || {};
  const videoUrl = typeof videoData === 'string' ? videoData : (videoData.url || '');
  const youtubeId = extraerYouTubeIdFront(videoUrl);
  const videoHTML = videoUrl ? `
    <section class="l-section l-video"><h2>🎬 Nuestro Video</h2>
      <div class="l-video-card">
        ${youtubeId ? `<div class="l-video-iframe-wrapper"><iframe src="https://www.youtube.com/embed/${youtubeId}?rel=0" allow="autoplay; encrypted-media; fullscreen" allowfullscreen loading="lazy"></iframe></div>` : `<div class="l-video-iframe-wrapper"><video controls preload="metadata"><source src="${videoUrl}" type="video/mp4"></video></div>`}
      </div>
    </section>` : '';
  
  const galeriaHTML = fotos.length ? `
    <section class="l-gallery">${fotos.map((f, i) => `
      <div class="l-gallery-item"><img src="${f.url}" onclick="lOpenLightbox(${i})"></div>
    `).join('')}</section>` : '';
  
  const mapaHTML = tieneMapa ? `
    <section class="l-section l-mapa"><h2>📍 Encuéntranos</h2>
      <div class="l-map-card"><iframe loading="lazy" src="https://www.openstreetmap.org/export/embed.html?bbox=${parseFloat(n.longitud)-0.006}%2C${parseFloat(n.latitud)-0.006}%2C${parseFloat(n.longitud)+0.006}%2C${parseFloat(n.latitud)+0.006}&layer=mapnik&marker=${n.latitud}%2C${n.longitud}"></iframe></div>
      <p class="l-direccion">${n.direccion||n.ubicacion||''}</p>
    </section>` : '';
  
  const contactoBotones = `
    ${whatsappDigits?`<a href="https://wa.me/${whatsappDigits}" class="l-btn l-btn-whatsapp" target="_blank">💬 WhatsApp</a>`:''}
    ${telDigits?`<a href="tel:${telDigits}" class="l-btn l-btn-call">📞 Llamar</a>`:''}
    ${tieneMapa?`<a href="https://www.google.com/maps/dir/?api=1&destination=${n.latitud},${n.longitud}" class="l-btn l-btn-maps" target="_blank">🧭 Cómo llegar</a>`:''}`;
  
  const fotosJS = JSON.stringify(fotos.map(f => ({ url: f.url, descripcion: f.descripcion || '' })));

  return `<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>${n.nombre||'Negocio'} | ${n.slogan||'Tu mejor opción'}</title>
<meta name="description" content="${descLarga.substring(0, 155)}">
${n.banner?`<meta property="og:image" content="${n.banner}">`:''}
<style>*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Segoe UI',system-ui,sans-serif;color:#333;background:#f0f2f5;line-height:1.6;padding:20px}
.l-wrap{max-width:640px;margin:0 auto;background:white;border-radius:20px;overflow:hidden;box-shadow:0 10px 40px rgba(0,0,0,0.1)}
.l-banner{width:100%;background:linear-gradient(135deg,${colorPrimario} 0%,${colorSecundario} 100%);${n.banner?`background-image:url('${n.banner}');background-size:cover;background-position:center;`:''}}
.l-banner-inner{display:flex;align-items:center;gap:14px;padding:16px;background:linear-gradient(135deg,rgba(0,0,0,0.15),rgba(0,0,0,0.45));min-height:100px}
.l-logo{width:64px;height:64px;border-radius:50%;object-fit:cover;border:3px solid white}
.l-banner-text h1{color:white;font-size:22px;font-weight:800}
.l-banner-text p{color:rgba(255,255,255,0.92);font-size:12.5px}
.l-slogan{padding:16px 24px 0;font-size:15px;font-style:italic;color:${colorPrimario};font-weight:600}
.l-gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;padding:20px 24px 0}
.l-gallery-item img{width:100%;height:140px;object-fit:cover;border-radius:12px;cursor:pointer}
.l-section{padding:0 24px 24px}
.l-section h2{font-size:18px;margin-bottom:12px}
.l-video-card{border-radius:14px;overflow:hidden;border:2px solid ${colorAcento}}
.l-video-iframe-wrapper{position:relative;padding-bottom:56.25%;height:0}
.l-video-iframe-wrapper iframe,.l-video-iframe-wrapper video{position:absolute;top:0;left:0;width:100%;height:100%;border:none}
.l-map-card{border-radius:14px;overflow:hidden}
.l-map-card iframe{width:100%;height:260px;border:0}
.l-direccion{margin-top:10px;font-size:13px;color:#666}
.l-btn-group{display:flex;flex-wrap:wrap;gap:10px;padding:0 24px 24px}
.l-btn{flex:1;min-width:140px;text-align:center;padding:13px 18px;border-radius:12px;font-weight:700;font-size:14px;text-decoration:none}
.l-btn-whatsapp{background:#25D366;color:white}
.l-btn-call{background:${colorPrimario};color:white}
.l-btn-maps{background:#4285F4;color:white}
footer{background:#1a1a2e;text-align:center;padding:22px 20px;color:#888}
.l-lightbox{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.92);z-index:5000;align-items:center;justify-content:center;flex-direction:column}
.l-lightbox.active{display:flex}
.l-lightbox img{max-width:100%;max-height:75vh;border-radius:12px}
.l-lightbox-back{margin-top:22px;background:white;color:#333;border:none;padding:12px 26px;border-radius:12px;font-weight:700;cursor:pointer}
@media(max-width:480px){.l-gallery{grid-template-columns:repeat(2,1fr)}}
</style></head><body>
<div class="l-wrap">
  <div class="l-banner"><div class="l-banner-inner">
    ${n.logo?`<img class="l-logo" src="${n.logo}">`:''}
    <div class="l-banner-text"><h1>${n.nombre||''}</h1>${descLarga?`<p>${descLarga}</p>`:''}</div>
  </div></div>
  ${n.slogan?`<p class="l-slogan">✨ ${n.slogan}</p>`:''}
  ${galeriaHTML}
  ${videoHTML}
  ${mapaHTML}
  <div class="l-btn-group">${contactoBotones}</div>
  ${footerHTML || '<footer><p>FrontPage Express</p></footer>'}
</div>
<div class="l-lightbox" id="lLightbox">
  <img id="lLightboxImg" src="">
  <button class="l-lightbox-back" onclick="lCloseLightbox()">← Volver</button>
</div>
<script>
var lFotos = ${fotosJS};
window.lOpenLightbox = function(i){ document.getElementById('lLightboxImg').src = lFotos[i].url; document.getElementById('lLightbox').classList.add('active'); };
window.lCloseLightbox = function(){ document.getElementById('lLightbox').classList.remove('active'); };
<\/script>
</body></html>`;
}

// ============================================================
// PREVIEW
// ============================================================
function previsualizarLanding(id) {
  const negocio = negocios.find(n => n.id === id);
  if (!negocio) return;
  currentPreviewHTML = construirLandingHTML(negocio);
  currentPreviewNombre = (negocio.nombre || 'negocio').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'') + '.html';
  currentPreviewId = negocio.id || '';
  document.getElementById('previewTitle').textContent = negocio.nombre || 'Landing';
  document.getElementById('previewOverlay').classList.add('active');
  document.getElementById('previewFrame').srcdoc = currentPreviewHTML;
  showToast('✅ Vista previa generada', 'success');
}

function cerrarPreview() {
  document.getElementById('previewOverlay').classList.remove('active');
  document.getElementById('previewFrame').srcdoc = '';
}

function descargarHTML() {
  if (!currentPreviewHTML) return;
  const blob = new Blob([currentPreviewHTML], { type: 'text/html' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = currentPreviewNombre;
  a.click();
  setTimeout(() => URL.revokeObjectURL(url), 3000);
}

async function publicarEnGitHub() {
  if (!currentPreviewHTML) { showToast('❌ No hay preview', 'error'); return; }
  const btn = document.getElementById('btnPublicarGitHub');
  btn.disabled = true;
  btn.textContent = '⏳ Publicando...';
  showLoading();
  const negocio = negocios.find(n => n.id === currentPreviewId);
  const sitemapXML = negocio ? generarSitemapLanding(negocio) : '';
  try {
    const result = await postViaIframe('publicarGitHub', currentPreviewId, {
      nombreArchivo: currentPreviewNombre,
      html: currentPreviewHTML,
      sitemap: sitemapXML,
      nombreSitemap: 'sitemap.xml'
    }, GITHUB_PUBLISH_URL);
    hideLoading();
    btn.disabled = false;
    btn.textContent = '🚀 Publicar';
    if (result.success) showToast('✅ Publicado', 'success');
    else showToast('❌ Error: ' + result.error, 'error');
  } catch(e) {
    hideLoading();
    btn.disabled = false;
    btn.textContent = '🚀 Publicar';
    showToast('❌ Error de conexión', 'error');
  }
}

function generarSitemapLanding(n) {
  const slug = (n.nombre || 'negocio').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
  return `<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>https://proyectosolaronline.github.io/${slug}/</loc><lastmod>${new Date().toISOString().split('T')[0]}</lastmod><changefreq>weekly</changefreq><priority>1.0</priority></url>
</urlset>`;
}

function showToast(mensaje, tipo = 'success') {
  document.querySelectorAll('.toast').forEach(t => t.remove());
  const toast = document.createElement('div');
  toast.className = `toast toast-${tipo}`;
  toast.textContent = mensaje;
  document.body.appendChild(toast);
  setTimeout(() => { toast.style.opacity = '0'; setTimeout(() => toast.remove(), 300); }, 3500);
}

// ============================================================
// MODO CLIENTE
// ============================================================
function verificarModoClienteEdicion() {
  const params = new URLSearchParams(window.location.search);
  const idCliente = params.get('editarCliente');
  if (!idCliente) return false;
  const exp = parseInt(params.get('exp'), 10);
  document.body.classList.add('modo-cliente-edicion');
  document.querySelector('.header').style.display = 'none';
  document.querySelector('.toolbar').style.display = 'none';
  document.querySelector('.sheet-list').style.display = 'none';
  document.querySelector('.fab-admin').style.display = 'none';
  if (!exp || Date.now() > exp) { document.body.innerHTML = '<div style="text-align:center;padding:40px;"><h2>⏰ Enlace expirado</h2></div>'; return true; }
  showLoading();
  callAPI('obtenerNegocios').then(result => {
    hideLoading();
    if (!result.success) return;
    negocios = result.negocios || [];
    const negocio = negocios.find(n => n.id === idCliente);
    if (!negocio) return;
    abrirModalEditar(negocio.id);
    document.getElementById('modalTitle').textContent = '✏️ Editar información';
    document.getElementById('btnGuardar').textContent = '💾 Guardar cambios';
  });
  return true;
}

console.log('✅ Sistema completo con video');
</script>

</body>
</html>
