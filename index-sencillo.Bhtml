            <h2 id="detailNombre"></h2>
            <p id="detailDescripcion"></p>
          </div>
        </div>
      </div>
    </div>
    <p class="detail-slogan" id="detailSlogan"></p>
    <div class="detail-gallery" id="detailGallery"></div>
    <div class="detail-contact-grid" id="detailContact"></div>
    <div class="detail-actions">
      <button class="btn btn-info" id="detailBtnMapa">📍 Cómo llegar</button>
      <button class="btn btn-outline" style="border-color:#667eea;color:#667eea;" id="detailBtnLanding">🌐 Ver Landing</button>
      <button class="btn btn-primary" id="detailBtnEditar">✏️ Editar</button>
      <button class="btn btn-warning" id="detailBtnCompartirEdicion">🔗 Compartir</button>
